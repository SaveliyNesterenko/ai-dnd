{
  "name": "ai-dnd-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 5173",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "npm run build && playwright test",
    "generate:api": "openapi-ts -i ../docs/openapi.json -o src/api/generated"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.0",
    "@tanstack/react-query": "^5.85.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.84.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.0"
  }
}
