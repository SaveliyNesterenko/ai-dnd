AI_DND_ENVIRONMENT=development
AI_DND_HOST=127.0.0.1
AI_DND_PORT=8000
AI_DND_LAN_MODE=false
AI_DND_LOG_LEVEL=INFO
AI_DND_DEBUG_PROMPTS=false
# AI_DND_WEB_DIST_DIR=C:/path/to/ai-dnd/web/dist
# AI_DND_DEMO_ASSETS_DIR=C:/path/to/ai-dnd/demo/assets
AI_DND_OPENAI_API_KEY=
AI_DND_OPENAI_BASE_URL=https://routerai.ru/api/v1
AI_DND_DEFAULT_MODEL=deepseek/deepseek-v3.2
AI_DND_STT_API_KEY=
AI_DND_STT_BASE_URL=https://api.nexara.ru/api/v1
AI_DND_STT_TIMEOUT_SECONDS=60
AI_DND_TTS_ENABLED=true
AI_DND_TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
AI_DND_TTS_LANGUAGE=ru
AI_DND_TTS_TEMPERATURE=0.75
