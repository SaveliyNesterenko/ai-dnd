# --- Секреты и ключи (САМОЕ ВАЖНОЕ) ---
.env
.env.local
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Виртуальное окружение ---
# (Зависит от того, как вы назвали папку, здесь учтены популярные варианты)
venv/
env/
.venv/
.env/

# --- Логи и временные файлы проекта ---
# Игнорируем папку logs, которую создает скрипт
logs/
*.log

# --- IDE и редакторы кода ---
.vscode/
.idea/
*.swp
*.swo

# --- Операционные системы ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Распределение (если будете собирать exe) ---
dist/
build/
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- New application runtime state ---
.ai-dnd/
*.db
*.db-shm
*.db-wal
backups/

# --- Frontend toolchain ---
web/node_modules/
web/dist/
web/playwright-report/
web/test-results/
web/.playwright-runtime/

# --- Legacy runtime data and unlicensed local assets ---
# Public, licensed fixtures belong under demo/.
/data/
/assets/

# --- Legacy state files created from an arbitrary working directory ---
/characters.json
/event_log.json
/npc.json
/public_state.json
/active_characters.json

# Demo assets and fixtures are explicitly tracked under demo/.
